generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}



model User {
  id                    String        @id @default(auto()) @map("_id") @db.ObjectId
  fullName              String
  email                 String        @unique
  password              String
  fcmToken              String?
  faceToken             String?
  profileImage          String        @default("")
  faceVerified          Boolean       @default(false)
  role                  userRole      @default(USER)
  isDeleted             Boolean       @default(false)
  isSubscribed          Boolean       @default(false)
  appNotificationActive Boolean       @default(true)
  stripePaymentId       String?
  planExpirationDate    DateTime?     @updatedAt
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  OTP                   OTP?
}


model OTP {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  otpCode      String
  otpExpiresAt DateTime // Security timeout for OTP validation
  userId       String   @unique @db.ObjectId
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, otpCode]) // Ensure unique active OTPs per user
  @@index([otpExpiresAt]) // For cleanup of expired OTPs
}

enum userRole {
  USER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum UserStatus {
  PENDING
  ACTIVE
  INACTIVE
  BLOCKED
  AVAILABLE
  UNAVAILABLE
}





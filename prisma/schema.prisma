generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(auto()) @map("_id") @db.ObjectId
  fullName         String
  email            String            @unique
  password         String
  phone            String?
  profileImage     String            @default("")
  role             GlobalRole        @default(USER)
  isDeleted        Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  isVerified       Boolean           @default(false)
  matchAdmin       Match?            @relation("MatchAdmin")
  matchMembership  MatchMember?
  bazarEntries     BazarEntry[]
  cookingSchedules CookingSchedule[]
  meals            MealEntry[]       @relation("MealOwner")
  // meals added by this user
  addedMeals       MealEntry[]       @relation("MealAddedBy")
}

model OTP {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  email        String   @unique
  otpCode      String
  otpExpiresAt DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([otpExpiresAt])
}

model Match {
  id                 String  @id @default(auto()) @map("_id") @db.ObjectId
  name               String
  address            String?
  description        String?
  approxTotalMembers Int     @default(1)
  monthlyMealRate    Float   @default(0) // cost per meal unit
  currency           String  @default("BDT")
  isActive           Boolean @default(true)

  adminId String @unique @db.ObjectId
  admin   User   @relation("MatchAdmin", fields: [adminId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members          MatchMember[]
  meals            MealEntry[]
  bazarEntries     BazarEntry[]
  cookingSchedules CookingSchedule[]
  monthlyReports   MonthlyReport[]
}

// MATCH MEMBER  (one membership per user)
model MatchMember {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  matchId   String       @map("matchId") @db.ObjectId
  match     Match        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId    String       @unique @db.ObjectId
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  matchRole MatchRole    @default(MEMBER)
  status    MemberStatus @default(ACTIVE)
  joinedAt  DateTime     @default(now())
  removedAt DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([matchId])
  @@unique([matchId, userId])
}

// MEAL ENTRY  (per member per day)
model MealEntry {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  matchId   String @db.ObjectId
  match     Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  // Meal Owner
  userId    String @db.ObjectId
  user      User   @relation("MealOwner", fields: [userId], references: [id], onDelete: Cascade)
  // Who added this meal entry
  addedById String @db.ObjectId
  addedBy   User   @relation("MealAddedBy", fields: [addedById], references: [id])

  date       DateTime // the day this meal belongs to
  breakfast  Float    @default(0)
  lunch      Float    @default(0)
  dinner     Float    @default(0)
  totalMeals Float    @default(0) // computed: breakfast+lunch+dinner
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([matchId, userId, date]) // one entry per member per day
  @@index([matchId, date])
}

// BAZAR ENTRY  (market / grocery expense)
model BazarEntry {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  matchId String @db.ObjectId
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId  String @db.ObjectId // who did the shopping
  user    User   @relation(fields: [userId], references: [id])

  date         DateTime
  amount       Float
  description  String?
  receiptImage String? // optional receipt photo URL

  isVerified Boolean   @default(false) // manager approval
  verifiedBy String?   @db.ObjectId
  verifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([matchId, date])
}

// COOKING SCHEDULE
model CookingSchedule {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  matchId String @db.ObjectId
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId  String @db.ObjectId // assigned cook
  user    User   @relation(fields: [userId], references: [id])

  date     DateTime
  mealTime MealTime
  note     String?
  status   ScheduleStatus @default(ASSIGNED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// MONTHLY REPORT  (auto-generated summary)
model MonthlyReport {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  matchId String @db.ObjectId
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  month          Int // 1–12
  year           Int
  totalMeals     Float     @default(0)
  totalBazarCost Float     @default(0)
  mealRate       Float     @default(0) // totalBazarCost / totalMeals
  isFinalized    Boolean   @default(false)
  finalizedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([matchId, month, year])
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────
enum GlobalRole {
  USER
  SUPER_ADMIN
}

enum MatchRole {
  ADMIN
  MANAGER
  MEMBER
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  REMOVED
}

enum MealTime {
  BREAKFAST
  LUNCH
  DINNER
}

enum ScheduleStatus {
  ASSIGNED
  COMPLETED
  SKIPPED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}
